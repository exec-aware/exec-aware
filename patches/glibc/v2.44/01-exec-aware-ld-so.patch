elf: add exec-awareness to the dynamic loader

From: Skye Soss <skye@soss.website>

Every ELF object that ld.so maps from the filesystem is opened and
validated by open_verify, including dlopen'd libraries, DT_NEEDED
dependencies, LD_PRELOAD and LD_AUDIT modules, and the main program
when ld.so is invoked directly.  Loading any of these runs their code,
so check them with execveat(AT_EXECVE_CHECK) once the ELF header has
been validated.  If the check fails and the SECBIT_EXEC_RESTRICT_FILE
securebit is set, refuse to load the object.

Assisted-by: Claude:claude-opus-5.5
---
 elf/dl-load.c                           |    8 ++++
 sysdeps/generic/dl-exec-check.h         |   30 ++++++++++++++++
 sysdeps/unix/sysv/linux/dl-exec-check.h |   59 +++++++++++++++++++++++++++++++
 3 files changed, 97 insertions(+)
 create mode 100644 sysdeps/generic/dl-exec-check.h
 create mode 100644 sysdeps/unix/sysv/linux/dl-exec-check.h

diff --git a/elf/dl-load.c b/elf/dl-load.c
index 95404ada..76d6581c 100644
--- a/elf/dl-load.c
+++ b/elf/dl-load.c
@@ -50,6 +50,7 @@
 #include <dl-map-segment-align.h>
 #include <dl-unmap-segments.h>
 #include <dl-machine-reject-phdr.h>
+#include <dl-exec-check.h>
 #include <dl-prop.h>
 #include <not-cancel.h>
 
@@ -1744,6 +1745,13 @@ open_verify (const char *name, int fd,
 	  goto lose;
 	}
 
+      /* Loading the object runs its code, so it must be executable.  */
+      errval = _dl_exec_check (fd, name);
+      if (__glibc_unlikely (errval != 0))
+	{
+	  errstring = N_("blocked by EXEC_RESTRICT_FILE");
+	  goto lose;
+	}
     }
   else
     {
