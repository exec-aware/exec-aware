diff --git a/sysdeps/unix/sysv/linux/dl-exec-check.h b/sysdeps/unix/sysv/linux/dl-exec-check.h
new file mode 100644
index 00000000..326e88ef
--- /dev/null
+++ b/sysdeps/unix/sysv/linux/dl-exec-check.h
@@ -0,0 +1,59 @@
+/* Check that an object may be loaded as code.  Linux version.
+   Copyright The GNU Toolchain Authors.
+   This file is part of the GNU C Library.
+
+   The GNU C Library is free software; you can redistribute it and/or
+   modify it under the terms of the GNU Lesser General Public
+   License as published by the Free Software Foundation; either
+   version 2.1 of the License, or (at your option) any later version.
+
+   The GNU C Library is distributed in the hope that it will be useful,
+   but WITHOUT ANY WARRANTY; without even the implied warranty of
+   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+   Lesser General Public License for more details.
+
+   You should have received a copy of the GNU Lesser General Public
+   License along with the GNU C Library; if not, see
+   <https://www.gnu.org/licenses/>.  */
+
+#ifndef _DL_EXEC_CHECK_H
+#define _DL_EXEC_CHECK_H
+
+#include <fcntl.h>
+#include <sys/prctl.h>
+#include <sysdep.h>
+
+/* From <linux/securebits.h>, Linux 6.14.  */
+#ifndef SECBIT_EXEC_RESTRICT_FILE
+# define SECBIT_EXEC_RESTRICT_FILE (1 << 8)
+#endif
+
+/* Return 0 if the object NAME open on FD may be loaded as code, or an errno
+   value if loading it must be refused.
+
+   Loading an object runs its code, so ask the kernel whether execve
+   would be allowed on it (AT_EXECVE_CHECK, Linux 6.14).  The check is
+   always made so that administrators can audit which files are loaded,
+   but a failure is only enforced if the process has opted in with the
+   SECBIT_EXEC_RESTRICT_FILE securebit.  Older kernels reject the
+   unknown flag and cannot set the securebit, so nothing is enforced
+   there.  NAME is passed as argv[0] so that it is visible to auditors
+   of the execveat call.  */
+static inline int
+_dl_exec_check (int fd, const char *name)
+{
+  int r = INTERNAL_SYSCALL_CALL (execveat, fd, "",
+				 ((char *const[2]) { (char *) name, NULL }),
+				 NULL, AT_EMPTY_PATH | AT_EXECVE_CHECK);
+  if (!INTERNAL_SYSCALL_ERROR_P (r))
+    return 0;
+
+  int secbits = INTERNAL_SYSCALL_CALL (prctl, PR_GET_SECUREBITS);
+  if (INTERNAL_SYSCALL_ERROR_P (secbits)
+      || (secbits & SECBIT_EXEC_RESTRICT_FILE) == 0)
+    return 0;
+
+  return INTERNAL_SYSCALL_ERRNO (r);
+}
+
+#endif /* dl-exec-check.h */
