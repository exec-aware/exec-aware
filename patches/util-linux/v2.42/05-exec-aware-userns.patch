+#ifndef SECBIT_EXEC_RESTRICT_FILE
+# define SECBIT_EXEC_RESTRICT_FILE (1 << 8)
+#endif
+#ifndef SECBIT_EXEC_RESTRICT_FILE_LOCKED
+# define SECBIT_EXEC_RESTRICT_FILE_LOCKED (1 << 9)
+#endif
+#ifndef SECBIT_EXEC_DENY_INTERACTIVE
+# define SECBIT_EXEC_DENY_INTERACTIVE (1 << 10)
+#endif
+#ifndef SECBIT_EXEC_DENY_INTERACTIVE_LOCKED
+# define SECBIT_EXEC_DENY_INTERACTIVE_LOCKED (1 << 11)
+#endif
+
+#define SECBIT_EXEC_ALL (SECBIT_EXEC_RESTRICT_FILE | \
+			 SECBIT_EXEC_RESTRICT_FILE_LOCKED | \
+			 SECBIT_EXEC_DENY_INTERACTIVE | \
+			 SECBIT_EXEC_DENY_INTERACTIVE_LOCKED)
+
+/* Creating or joining a user namespace resets the securebits, which
+ * turns off the checks done by exec-aware programs. Save the exec
+ * securebits (and their locks) before, and restore them after. */
+int get_exec_securebits(void)
+{
+	int bits = prctl(PR_GET_SECUREBITS, 0, 0, 0, 0);
+
+	return bits < 0 ? 0 : bits & SECBIT_EXEC_ALL;
+}
+
+void restore_exec_securebits(int bits)
+{
+	int cur;
+
+	if (!bits)
+		return;
+
+	/* Like the exec-aware programs themselves, don't fail when the
+	 * securebits are unavailable */
+	cur = prctl(PR_GET_SECUREBITS, 0, 0, 0, 0);
+	if (cur < 0 || (cur & bits) == bits)
+		return;
+
+	/* The exec securebits don't need CAP_SETPCAP */
+	if (prctl(PR_SET_SECUREBITS, cur | bits, 0, 0, 0) < 0)
+		warn(_("cannot restore exec securebits"));
+}
+
