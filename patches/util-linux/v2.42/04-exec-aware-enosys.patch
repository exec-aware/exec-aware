diff --git a/misc-utils/enosys.c b/misc-utils/enosys.c
index f1438b8e8..b668bea5c 100644
--- a/misc-utils/enosys.c
+++ b/misc-utils/enosys.c
@@ -36,6 +36,10 @@
 #include "seccomp.h"
 #include "all-io.h"
 
+#ifndef SECBIT_EXEC_DENY_INTERACTIVE
+# define SECBIT_EXEC_DENY_INTERACTIVE (1 << 10)
+#endif
+
 #define IS_LITTLE_ENDIAN (__BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__)
 
 #define syscall_nr (offsetof(struct seccomp_data, nr))
@@ -287,6 +291,14 @@ int main(int argc, char **argv)
 		return EXIT_SUCCESS;
 	}
 
+	/* The filter decides what every syscall returns, including the
+	 * prctl() and execveat() calls used by exec-aware programs.
+	 * Building it from the command line is running code that doesn't
+	 * come from a file. */
+	int secbits = prctl(PR_GET_SECUREBITS, 0, 0, 0, 0);
+	if (secbits >= 0 && (secbits & SECBIT_EXEC_DENY_INTERACTIVE))
+		errx(EXIT_FAILURE, _("cannot load seccomp filter: blocked by EXEC_DENY_INTERACTIVE"));
+
 	struct sock_fprog prog = {
 		.len    = f - filter,
 		.filter = filter,
