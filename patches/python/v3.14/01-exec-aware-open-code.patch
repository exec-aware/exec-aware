diff --git a/Objects/fileobject.c b/Objects/fileobject.c
index e624405..9c2ac27 100644
--- a/Objects/fileobject.c
+++ b/Objects/fileobject.c
@@ -2,6 +2,7 @@
 
 #include "Python.h"
 #include "pycore_call.h"          // _PyObject_CallNoArgs()
+#include "pycore_fileutils.h"     // _Py_CheckExecFd()
 #include "pycore_runtime.h"       // _PyRuntime
 #include "pycore_unicodeobject.h" // _PyUnicode_AsUTF8String()
 
@@ -497,6 +498,27 @@ PyFile_SetOpenCodeHook(Py_OpenCodeHookFunction hook, void *userData) {
     return 0;
 }
 
+/* Close f and raise an exception if the kernel does not allow executing the
+   code in it. An open_code hook installed by an embedder replaces this check. */
+static int
+open_code_check_exec(PyObject *f, PyObject *path)
+{
+    int fd = PyObject_AsFileDescriptor(f);
+    if (fd >= 0 && _Py_CheckExecFd(fd, path) == 0) {
+        return 0;
+    }
+    PyObject *exc = PyErr_GetRaisedException();
+    PyObject *res = PyObject_CallMethod(f, "close", NULL);
+    if (res == NULL) {
+        _PyErr_ChainExceptions1(exc);
+    }
+    else {
+        Py_DECREF(res);
+        PyErr_SetRaisedException(exc);
+    }
+    return -1;
+}
+
 PyObject *
 PyFile_OpenCodeObject(PyObject *path)
 {
@@ -517,6 +539,9 @@ PyFile_OpenCodeObject(PyObject *path)
             f = PyObject_CallFunction(open, "Os", path, "rb");
             Py_DECREF(open);
         }
+        if (f != NULL && open_code_check_exec(f, path) < 0) {
+            Py_CLEAR(f);
+        }
     }
 
     return f;
