diff --git a/Include/internal/pycore_fileutils.h b/Include/internal/pycore_fileutils.h
index 2c6d6da..a8bad7f 100644
--- a/Include/internal/pycore_fileutils.h
+++ b/Include/internal/pycore_fileutils.h
@@ -314,6 +314,24 @@ extern int _Py_GetTicksPerSecond(long *ticks_per_second);
 // Export for '_testcapi' shared extension
 PyAPI_FUNC(int) _Py_IsValidFD(int fd);
 
+/* Executability checks (Linux 6.14+ AT_EXECVE_CHECK).
+
+   _Py_CheckExecFd() asks the kernel whether the code read from fd could be
+   executed. filename is the file's name as it was opened, and is passed to
+   the kernel as argv[0] so audit tools can see which file was checked. If the
+   check fails, SECBIT_EXEC_RESTRICT_FILE decides whether the code is blocked.
+   If filename is NULL, fd is standard input or another stream without a name,
+   and SECBIT_EXEC_DENY_INTERACTIVE decides instead.
+
+   _Py_CheckExecInteractive() checks SECBIT_EXEC_DENY_INTERACTIVE before
+   running code that does not come from a file descriptor, such as -c.
+   what names that source in the error message.
+
+   Both return 0 if the code may run, or raise an exception and return -1 if
+   it is blocked. */
+extern int _Py_CheckExecFd(int fd, PyObject *filename);
+extern int _Py_CheckExecInteractive(const char *what);
+
 #ifdef __cplusplus
 }
 #endif
