+
 #ifdef O_CLOEXEC
 /* Does open() support the O_CLOEXEC flag? Possible values:
 
@@ -3110,3 +3115,91 @@ _Py_IsValidFD(int fd)
     return (fstat(fd, &st) == 0);
 #endif
 }
+
+
+#if defined(__linux__) && defined(SYS_execveat)
+/* from <linux/fcntl.h>; not yet in libc headers */
+#ifndef AT_EXECVE_CHECK
+#  define AT_EXECVE_CHECK 0x10000
+#endif
+/* from <linux/securebits.h> */
+#define SECBIT_EXEC_RESTRICT_FILE    (1 << 8)
+#define SECBIT_EXEC_DENY_INTERACTIVE (1 << 10)
+
+static int
+exec_securebit_is_set(int bit)
+{
+    int secbits = prctl(PR_GET_SECUREBITS);
+    return secbits >= 0 && (secbits & bit);
+}
+
+int
+_Py_CheckExecFd(int fd, PyObject *filename)
+{
+    PyObject *name;
+    if (filename != NULL) {
+        name = PyUnicode_EncodeFSDefault(filename);
+    }
+    else {
+        name = PyBytes_FromFormat("/proc/self/fd/%d", fd);
+    }
+    if (name == NULL) {
+        return -1;
+    }
+
+    /* not every libc provides an execveat() wrapper */
+    char *const argv[2] = { PyBytes_AS_STRING(name), NULL };
+    int res;
+    Py_BEGIN_ALLOW_THREADS
+    res = (int)syscall(SYS_execveat, fd, "", argv, NULL,
+                       AT_EMPTY_PATH | AT_EXECVE_CHECK);
+    Py_END_ALLOW_THREADS
+    int saved_errno = errno;
+    Py_DECREF(name);
+    if (res == 0) {
+        return 0;
+    }
+
+    if (filename == NULL) {
+        if (!exec_securebit_is_set(SECBIT_EXEC_DENY_INTERACTIVE)) {
+            return 0;
+        }
+        PyErr_Format(PyExc_PermissionError,
+                     "reading code from file descriptor %d "
+                     "blocked by EXEC_DENY_INTERACTIVE", fd);
+        return -1;
+    }
+    if (!exec_securebit_is_set(SECBIT_EXEC_RESTRICT_FILE)) {
+        return 0;
+    }
+    errno = saved_errno;
+    PyErr_SetFromErrnoWithFilenameObject(PyExc_OSError, filename);
+    return -1;
+}
+
+int
+_Py_CheckExecInteractive(const char *what)
+{
+    if (!exec_securebit_is_set(SECBIT_EXEC_DENY_INTERACTIVE)) {
+        return 0;
+    }
+    PyErr_Format(PyExc_PermissionError,
+                 "%s blocked by EXEC_DENY_INTERACTIVE", what);
+    return -1;
+}
+
+#else
+
+int
+_Py_CheckExecFd(int Py_UNUSED(fd), PyObject *Py_UNUSED(filename))
+{
+    return 0;
+}
+
+int
+_Py_CheckExecInteractive(const char *Py_UNUSED(what))
+{
+    return 0;
+}
+
+#endif
