index 78603d4..d241194 100644
--- a/Python/fileutils.c
+++ b/Python/fileutils.c
@@ -38,6 +38,11 @@ extern int winerror_to_errno(int);
 #  include <fcntl.h>              // fcntl(F_GETFD)
 #endif
 
+#ifdef __linux__
+#  include <sys/prctl.h>          // PR_GET_SECUREBITS
+#  include <sys/syscall.h>        // SYS_execveat
