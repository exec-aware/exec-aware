diff --git a/execaware.h b/execaware.h
new file mode 100644
index 0000000..08a3210
--- /dev/null
+++ b/execaware.h
@@ -0,0 +1,79 @@
+/*    execaware.h
+ *
+ *    Copyright (C) 2026 by Skye Soss and others
+ *
+ *    You may distribute under the terms of either the GNU General Public
+ *    License or the Artistic License, as specified in the README file.
+ *
+ */
+
+/* Executability checks for code that perl reads from files, using the
+ * AT_EXECVE_CHECK flag and the SECBIT_EXEC_RESTRICT_FILE and
+ * SECBIT_EXEC_DENY_INTERACTIVE securebits added in Linux 6.14.
+ *
+ * The check is always performed, so that it can be audited, but its result
+ * is only enforced when the corresponding securebit is set.
+ */
+
+#ifndef PERL_EXECAWARE_H_
+#define PERL_EXECAWARE_H_
+
+#if defined(__linux__)
+
+#include <fcntl.h>
+#include <sys/prctl.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+/* execveat() and AT_EMPTY_PATH need _GNU_SOURCE on glibc, so use the
+ * syscall directly. */
+#ifndef AT_EMPTY_PATH
+#  define AT_EMPTY_PATH 0x1000
+#endif
+/* from <linux/fcntl.h> */
+#ifndef AT_EXECVE_CHECK
+#  define AT_EXECVE_CHECK 0x10000
+#endif
+/* from <linux/securebits.h> */
+#define PERL_SECBIT_EXEC_RESTRICT_FILE    (1 << 8)
+#define PERL_SECBIT_EXEC_DENY_INTERACTIVE (1 << 10)
+
+/* Returns 0 if the file open on fd may be executed.  name is passed as
+ * argv[0] so that audit tools can see which file was checked. */
+PERL_STATIC_INLINE int
+check_fd_exec(int fd, const char *name)
+{
+    char *argv[2];
+    argv[0] = (char *)name;
+    argv[1] = NULL;
+    return syscall(SYS_execveat, fd, "", argv, NULL,
+                   AT_EMPTY_PATH | AT_EXECVE_CHECK);
+}
+
+PERL_STATIC_INLINE bool
+exec_restrict_file(void)
+{
+    const int secbits = prctl(PR_GET_SECUREBITS);
+    return secbits >= 0 && (secbits & PERL_SECBIT_EXEC_RESTRICT_FILE);
+}
+
+PERL_STATIC_INLINE bool
+exec_deny_interactive(void)
+{
+    const int secbits = prctl(PR_GET_SECUREBITS);
+    return secbits >= 0 && (secbits & PERL_SECBIT_EXEC_DENY_INTERACTIVE);
+}
+
+#else
+
+#  define check_fd_exec(fd, name) ((void)(fd), (void)(name), 0)
+#  define exec_restrict_file()     FALSE
+#  define exec_deny_interactive()  FALSE
+
+#endif
+
+#endif /* PERL_EXECAWARE_H_ */
+
+/*
+ * ex: set ts=8 sts=4 sw=4 et:
+ */
diff --git a/perl.c b/perl.c
index 59dd10f..d4c1b68 100644
--- a/perl.c
+++ b/perl.c
@@ -37,6 +37,7 @@
 #include "EXTERN.h"
 #define PERL_IN_PERL_C
 #include "perl.h"
+#include "execaware.h"
 #include "patchlevel.h"			/* for local_patches */
 #include "XSUB.h"
 
@@ -2177,6 +2178,15 @@ S_moreswitch_m(pTHX_ char option, const char *s)
         croak("Invalid module name %.*s with -%c option: "
                             "contains single ':'",
                             (int)(s - start), start, option);
+    if (*s != '=' && exec_deny_interactive()) {
+        /* Anything but a version after the module name is Perl code */
+        const char *v = s;
+        while (isDIGIT(*v) || *v == '.' || *v == '_')
+            v++;
+        if (*v)
+            croak("Code in -%c option blocked by EXEC_DENY_INTERACTIVE",
+                  option);
+    }
     end = s + strlen(s);
     if (*s != '=') {
         sv_catpvn(sv, start, end - start);
@@ -2315,6 +2325,9 @@ S_parse_body(pTHX_ char **env, XSINIT_t xsinit)
             /* FALLTHROUGH */
         case 'e':
             forbid_setid('e', FALSE);
+            if (exec_deny_interactive())
+                croak("Code in -%c option blocked by EXEC_DENY_INTERACTIVE",
+                      c);
         minus_e = TRUE;
             if (!PL_e_script) {
                 PL_e_script = newSVpvs("");
@@ -2473,6 +2486,16 @@ S_parse_body(pTHX_ char **env, XSINIT_t xsinit)
     }
     }
 
+    /* -F patterns starting with a quote are inserted into the program as
+     * written; -F on the #! line comes from an already checked file. */
+    if (PL_minus_F
+        && (*PL_splitstr == '/' || *PL_splitstr == '\'' || *PL_splitstr == '"')
+        && strchr(PL_splitstr + 1, *PL_splitstr)
+        && exec_deny_interactive())
+    {
+        croak("Code in -F option blocked by EXEC_DENY_INTERACTIVE");
+    }
+
 #ifndef NO_PERL_INTERNAL_RAND_SEED
     /* If we're not set[ug]id, we might have honored
        PERL_INTERNAL_RAND_SEED in perl_construct().
@@ -2559,6 +2582,10 @@ S_parse_body(pTHX_ char **env, XSINIT_t xsinit)
         if (!rsfp) {
             rsfp = PerlIO_stdin();
             lex_start_flags = LEX_DONT_CLOSE_RSFP;
+            if (check_fd_exec(0, "/proc/self/fd/0") < 0
+                && exec_deny_interactive())
+                croak("Can't execute perl script from stdin: "
+                      "blocked by EXEC_DENY_INTERACTIVE\n");
         }
 
         validate_suid(rsfp);
@@ -3795,6 +3822,10 @@ Perl_moreswitches(pTHX_ const char *s)
 
             /* We now allow -d:Module=Foo,Bar and -d:-Module */
             while(isWORDCHAR(*s) || *s==':') ++s;
+            /* Anything else is Perl code, and a brace would end q{} */
+            if ((*s == '=' ? strpbrk(s, "{}") != NULL : *s != '\0')
+                && exec_deny_interactive())
+                croak("Code in -d option blocked by EXEC_DENY_INTERACTIVE");
             if (*s != '=')
                 sv_catpvn(sv, start, end - start);
             else {
@@ -3807,6 +3838,10 @@ Perl_moreswitches(pTHX_ const char *s)
             my_setenv("PERL5DB", SvPV_nolen_const(sv));
             SvREFCNT_dec(sv);
         }
+        /* The default debugger reads commands from the terminal, and
+         * PERL5DB holds code to run in its place */
+        else if (exec_deny_interactive())
+            croak("Debugger blocked by EXEC_DENY_INTERACTIVE");
         if (!PL_perldb) {
             PL_perldb = PERLDB_ALL;
             init_debugger();
@@ -4313,6 +4348,14 @@ S_open_script(pTHX_ const char *scriptname, bool dosearch, bool *suidscript)
             CopFILE(PL_curcop),
             Strerror(EISDIR));
 
+    /* -e and -V read their program from the bit bucket */
+    if (strNE(scriptname, BIT_BUCKET)
+        && check_fd_exec(fd, scriptname) < 0
+        && exec_restrict_file())
+        croak("Can't execute perl script \"%s\": "
+              "blocked by EXEC_RESTRICT_FILE\n",
+              CopFILE(PL_curcop));
+
     return rsfp;
 }
 
