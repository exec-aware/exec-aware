diff --git a/builtins/evalfile.c b/builtins/evalfile.c
index 3026c5f..cd4d31b 100644
--- a/builtins/evalfile.c
+++ b/builtins/evalfile.c
@@ -145,6 +145,22 @@ file_error_and_exit:
       return ((flags & FEVAL_BUILTIN) ? EXECUTION_FAILURE : -1);
     }
 
+  /* fc executes a temporary file holding commands the user typed or edited,
+     so treat it as interactive input rather than as a file. */
+  if (check_fd_exec (fd, filename) < 0 &&
+      ((flags & FEVAL_HISTORY) ? exec_deny_interactive () : exec_restrict_file ()))
+    {
+      (*errfunc) (_("%s: cannot execute: blocked by %s"), filename,
+		  (flags & FEVAL_HISTORY) ? "EXEC_DENY_INTERACTIVE" : "EXEC_RESTRICT_FILE");
+      close (fd);
+      if (flags & FEVAL_LONGJMP)
+	{
+	  last_command_exit_value = EXECUTION_FAILURE;
+	  jump_to_top_level (EXITPROG);
+	}
+      return ((flags & FEVAL_BUILTIN) ? EXECUTION_FAILURE : -1);
+    }
+
   file_size = (size_t)finfo.st_size;
   /* Check for overflow with large files. */
   if (file_size != finfo.st_size || file_size + 1 < file_size)
diff --git a/general.c b/general.c
index c8442ef..56dd1d0 100644
--- a/general.c
+++ b/general.c
@@ -1477,3 +1477,64 @@ default_columns (void)
 
   return (c > 0 ? c : 80);
 }
+
+/* Linux 6.14+ executability checks */
+#if defined (__linux__)
+#  include <sys/prctl.h>
+/* from <linux/fcntl.h> */
+#  if !defined (AT_EMPTY_PATH)
+#    define AT_EMPTY_PATH 0x1000
+#  endif
+#  if !defined (AT_EXECVE_CHECK)
+#    define AT_EXECVE_CHECK 0x10000
+#  endif
+#  define SECBIT_EXEC_RESTRICT_FILE	(1 << 8)
+#  define SECBIT_EXEC_DENY_INTERACTIVE	(1 << 10)
+
+/* Return 0 if the kernel would allow the file open on FD to be executed,
+   -1 otherwise.  NAME is the name FD was opened with, passed as argv[0] so
+   audit tools can see which file was checked.  Always called, even when
+   not enforcing, so the check can be audited. */
+int
+check_fd_exec (int fd, const char *name)
+{
+  return (execveat (fd, "", (char *const[2]){ (char *)name, NULL }, NULL,
+		    AT_EMPTY_PATH | AT_EXECVE_CHECK));
+}
+
+int
+exec_restrict_file (void)
+{
+  int secbits;
+
+  secbits = prctl (PR_GET_SECUREBITS);
+  return (secbits >= 0 && (secbits & SECBIT_EXEC_RESTRICT_FILE));
+}
+
+int
+exec_deny_interactive (void)
+{
+  int secbits;
+
+  secbits = prctl (PR_GET_SECUREBITS);
+  return (secbits >= 0 && (secbits & SECBIT_EXEC_DENY_INTERACTIVE));
+}
+#else
+int
+check_fd_exec (int fd, const char *name)
+{
+  return 0;
+}
+
+int
+exec_restrict_file (void)
+{
+  return 0;
+}
+
+int
+exec_deny_interactive (void)
+{
+  return 0;
+}
+#endif
