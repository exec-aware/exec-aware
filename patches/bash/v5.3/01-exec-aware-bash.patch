diff --git a/shell.c b/shell.c
index e59029c..c8dc089 100644
--- a/shell.c
+++ b/shell.c
@@ -703,6 +703,24 @@ main (int argc, char **argv, char **env)
   else
     arg_index = bind_args (argv, arg_index, argc, 1);	/* $1 ... $n */
 
+  /* Refuse to run code that does not come from an executable file before
+     running any startup files.  A script file is checked when it's opened. */
+  if (wordexp_only == 0 && shell_script_filename == 0)
+    {
+      if (command_execution_string && exec_deny_interactive ())
+	{
+	  internal_error (_("-c: blocked by EXEC_DENY_INTERACTIVE"));
+	  exit (EX_NOEXEC);
+	}
+      else if (command_execution_string == 0 &&
+	       check_fd_exec (fileno (stdin), "/proc/self/fd/0") < 0 &&
+	       exec_deny_interactive ())
+	{
+	  internal_error (_("stdin: blocked by EXEC_DENY_INTERACTIVE"));
+	  exit (EX_NOEXEC);
+	}
+    }
+
   /* The startup files are run with `set -e' temporarily disabled. */
   ssh_reading_startup_files = 0;		/* paranoia */
   if (locally_skip_execution == 0 && running_setuid == 0)
@@ -1106,7 +1124,12 @@ execute_env_file (char *env_file)
 
   if (env_file && *env_file)
     {
-      fn = expand_string_unsplit_to_string (env_file, Q_DOUBLE_QUOTES);
+      /* Expanding the value can run command substitutions, which would
+	 execute code taken from the environment. */
+      if (exec_deny_interactive ())
+	fn = savestring (env_file);
+      else
+	fn = expand_string_unsplit_to_string (env_file, Q_DOUBLE_QUOTES);
       if (fn && *fn)
 	maybe_execute_file (fn, 1);
       FREE (fn);
@@ -1632,6 +1655,15 @@ open_shell_script (char *script_name)
       sh_exit (EX_NOINPUT);
     }
 
+  if (check_fd_exec (fd, filename) < 0 && exec_restrict_file ())
+    {
+      internal_error (_("%s: cannot execute: blocked by EXEC_RESTRICT_FILE"), filename);
+#if defined (JOB_CONTROL)
+      end_job_control ();	/* just in case we were run as bash -i script */
+#endif
+      sh_exit (EX_NOEXEC);
+    }
+
 #if defined (ARRAY_VARS)
   GET_ARRAY_FROM_VAR ("FUNCNAME", funcname_v, funcname_a);
   GET_ARRAY_FROM_VAR ("BASH_SOURCE", bash_source_v, bash_source_a);
